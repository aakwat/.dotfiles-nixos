// Zellij theme — Gruvbox Dark Hard.
// Modern extended slots (needed for compact-bar in zellij 0.42+) plus
// legacy 8-color block for older UI elements.
themes {
  gruvbox-dark-hard {
    // ── legacy 8-color palette ─────────────────────────
    bg      "#1d2021"
    fg      "#ebdbb2"
    red     "#fb4934"
    green   "#b8bb26"
    blue    "#83a598"
    yellow  "#fabd2f"
    magenta "#d3869b"
    orange  "#fe8019"
    cyan    "#8ec07c"
    black   "#1d2021"
    white   "#fbf1c7"

    // ── modern extended slots (compact-bar, tables, lists) ──
    text_unselected {
      base       "#a89984"
      background "#1d2021"
      emphasis_0 "#fe8019"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#fabd2f"
    }
    text_selected {
      base       "#1d2021"
      background "#83a598"
      emphasis_0 "#fb4934"
      emphasis_1 "#fabd2f"
      emphasis_2 "#8ec07c"
      emphasis_3 "#8ec07c"
    }
    ribbon_selected {
      base       "#1d2021"
      background "#fe8019"
      emphasis_0 "#fb4934"
      emphasis_1 "#fabd2f"
      emphasis_2 "#8ec07c"
      emphasis_3 "#d3869b"
    }
    ribbon_unselected {
      base       "#a89984"
      background "#504945"
      emphasis_0 "#928374"
      emphasis_1 "#a89984"
      emphasis_2 "#928374"
      emphasis_3 "#a89984"
    }
    table_title {
      base       "#fabd2f"
      background "#1d2021"
      emphasis_0 "#fb4934"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#d3869b"
    }
    table_cell_selected {
      base       "#1d2021"
      background "#fabd2f"
      emphasis_0 "#fb4934"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#8ec07c"
    }
    table_cell_unselected {
      base       "#ebdbb2"
      background "#3c3836"
      emphasis_0 "#fabd2f"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#fb4934"
    }
    list_selected {
      base       "#1d2021"
      background "#fabd2f"
      emphasis_0 "#fb4934"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#8ec07c"
    }
    list_unselected {
      base       "#ebdbb2"
      background "#1d2021"
      emphasis_0 "#fabd2f"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#fb4934"
    }
    frame_selected {
      base       "#fabd2f"
      background "#1d2021"
      emphasis_0 "#fb4934"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#d3869b"
    }
    frame_highlight {
      base       "#fe8019"
      background "#1d2021"
      emphasis_0 "#fabd2f"
      emphasis_1 "#83a598"
      emphasis_2 "#8ec07c"
      emphasis_3 "#d3869b"
    }
    exit_code_success {
      base       "#b8bb26"
      background "#1d2021"
      emphasis_0 "#83a598"
      emphasis_1 "#fabd2f"
      emphasis_2 "#8ec07c"
      emphasis_3 "#d3869b"
    }
    exit_code_error {
      base       "#fb4934"
      background "#1d2021"
      emphasis_0 "#fabd2f"
      emphasis_1 "#83a598"
      emphasis_2 "#fe8019"
      emphasis_3 "#d3869b"
    }
    multiplayer_user_colors {
      player_1  "#83a598"
      player_2  "#b8bb26"
      player_3  "#d3869b"
      player_4  "#fabd2f"
      player_5  "#8ec07c"
      player_6  "#fb4934"
      player_7  "#fe8019"
      player_8  "#a89984"
      player_9  "#fbf1c7"
      player_10 "#928374"
    }
  }
}
