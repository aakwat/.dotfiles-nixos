// niri — foot, tofi, waybar, mako, hyprlock, hypridle.
// Default reference: /usr/share/doc/niri/default-config.kdl

// ── Input ────────────────────────────────────────────────
input {
  keyboard {
    xkb {
      layout  "us,mm"
      options "grp:ctrl_space_toggle"
    }
  }
  touchpad {
    tap
    natural-scroll
    dwt
    accel-profile "flat"
  }
  mouse { accel-profile "flat"; }
  focus-follows-mouse
}

// ── Outputs ──────────────────────────────────────────────
output "eDP-1"    { scale 1; }
output "HDMI-A-1" { scale 1; }

// ── Layout ───────────────────────────────────────────────
layout {
  gaps 8
  focus-ring { width 2; }
  preset-column-widths { proportion 0.333; proportion 0.5; proportion 0.667; }
}

// ── Autostart ────────────────────────────────────────────
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "hypridle"
spawn-at-startup "fcitx5"    "-d"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "wl-paste --type text  --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "sh" "-c" "sleep 0.5 && $HOME/.local/bin/wallpaper"
spawn-at-startup "systemctl" "--user" "start" "hyprpolkitagent"
spawn-at-startup "xwayland-satellite"

// Point spawned X11 apps at the Xwayland instance xwayland-satellite creates.
environment {
  DISPLAY ":0"
}

// ── Misc ─────────────────────────────────────────────────
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H-%M-%S.png"
prefer-no-csd

// Draw focus ring AROUND semi-transparent windows, not behind them.
window-rule {
  draw-border-with-background false
}

// ── Keybinds ─────────────────────────────────────────────
binds {
  // Apps
  Mod+Return      { spawn "foot"; }
  Mod+T           { spawn "foot"; }
  Mod+E           { spawn "nemo"; }
  Mod+B           { spawn "librewolf"; }
  Mod+D           { spawn "sh" "-c" "pgrep -x tofi >/dev/null && pkill -x tofi || tofi -o \"$(niri msg -j focused-output | jq -r .name)\""; }
  Mod+Space       { spawn "sh" "-c" "pgrep -x tofi >/dev/null && pkill -x tofi || tofi -o \"$(niri msg -j focused-output | jq -r .name)\""; }

  // Window mgmt
  Mod+W           { close-window; }
  Mod+Q           { close-window; }
  Mod+Shift+Q     { quit; }
  Mod+F           { fullscreen-window; }
  Mod+Ctrl+F      { maximize-column; }
  Mod+V           { toggle-window-floating; }
  Mod+C           { center-column; }
  Mod+M           { toggle-overview; }

  // Focus (vim hjkl + arrows)
  Mod+H           { focus-column-or-monitor-left; }
  Mod+L           { focus-column-or-monitor-right; }
  Mod+J           { focus-window-or-monitor-down; }
  Mod+K           { focus-window-or-monitor-up; }
  Mod+Left        { focus-column-left; }
  Mod+Right       { focus-column-right; }
  Mod+Down        { focus-window-down; }
  Mod+Up          { focus-window-up; }

  // Move
  Mod+Shift+H     { move-column-left; }
  Mod+Shift+L     { move-column-right; }
  Mod+Shift+J     { move-window-down; }
  Mod+Shift+K     { move-window-up; }
  Mod+Shift+Left  { move-column-left; }
  Mod+Shift+Right { move-column-right; }
  Mod+Shift+Down  { move-window-down; }
  Mod+Shift+Up    { move-window-up; }

  // Cycle
  Mod+Tab         { focus-workspace-down; }
  Mod+Shift+Tab   { focus-workspace-up; }
  Alt+Tab         { focus-window-down; }
  Alt+Shift+Tab   { focus-window-up; }

  // Workspaces 1..10
  Mod+1           { focus-workspace 1; }
  Mod+2           { focus-workspace 2; }
  Mod+3           { focus-workspace 3; }
  Mod+4           { focus-workspace 4; }
  Mod+5           { focus-workspace 5; }
  Mod+6           { focus-workspace 6; }
  Mod+7           { focus-workspace 7; }
  Mod+8           { focus-workspace 8; }
  Mod+9           { focus-workspace 9; }
  Mod+0           { focus-workspace 10; }
  Mod+Shift+1     { move-column-to-workspace 1; }
  Mod+Shift+2     { move-column-to-workspace 2; }
  Mod+Shift+3     { move-column-to-workspace 3; }
  Mod+Shift+4     { move-column-to-workspace 4; }
  Mod+Shift+5     { move-column-to-workspace 5; }
  Mod+Shift+6     { move-column-to-workspace 6; }
  Mod+Shift+7     { move-column-to-workspace 7; }
  Mod+Shift+8     { move-column-to-workspace 8; }
  Mod+Shift+9     { move-column-to-workspace 9; }
  Mod+Shift+0     { move-column-to-workspace 10; }

  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

  // Resize (Mod+Alt+hjkl/arrows, 40px steps)
  Mod+Alt+H       { set-column-width "-40"; }
  Mod+Alt+L       { set-column-width "+40"; }
  Mod+Alt+K       { set-window-height "-40"; }
  Mod+Alt+J       { set-window-height "+40"; }
  Mod+Alt+Left    { set-column-width "-40"; }
  Mod+Alt+Right   { set-column-width "+40"; }
  Mod+Alt+Up      { set-window-height "-40"; }
  Mod+Alt+Down    { set-window-height "+40"; }
  Mod+R           { switch-preset-column-width; }
  Mod+G           { switch-preset-window-height; }

  // Screenshots (niri native → ~/Pictures/Screenshots/)
  Print           { screenshot; }
  Shift+Print     { screenshot-screen; }
  Mod+Print       { screenshot-screen; }
  Mod+Shift+S     { screenshot-window; }

  // Clipboard picker via tofi
  Mod+Shift+V     { spawn "sh" "-c" "cliphist list | tofi --mode dmenu -o \"$(niri msg -j focused-output | jq -r .name)\" | cliphist decode | wl-copy"; }

  // Powermenu / wallpaper / emoji
  Mod+X           { spawn "sh" "-c" "$HOME/.local/bin/powermenu"; }
  Mod+Shift+W     { spawn "sh" "-c" "$HOME/.local/bin/wallpaper --random"; }
  Mod+Ctrl+W      { spawn "sh" "-c" "$HOME/.local/bin/wallpaper-picker"; }

  // Lock (session-level via loginctl → hyprlock)
  Mod+Ctrl+L      { spawn "loginctl" "lock-session"; }

  // Task manager
  Mod+Escape      { spawn "foot" "-T" "btop" "btop"; }

  // Reload niri config
  Mod+Comma       { spawn "niri" "msg" "action" "load-config-file"; }

  // Audio / brightness / media (allow-when-locked = works on lock screen)
  XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
  XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
  XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
  XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }
}
